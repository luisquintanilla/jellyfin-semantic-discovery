<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Qdrant" Version="17.0.0" />
    <PackageVersion Include="Aspire.Qdrant.Client" Version="17.0.0" />
    <PackageVersion Include="Aspire.Azure.AI.OpenAI" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.OllamaSharp" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label=".NET AI building blocks">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="CommunityToolkit.DocumentExtraction.PdfPig" Version="1.0.0-preview" />
    <PackageVersion Include="CommunityToolkit.DocumentExtraction.VisionLanguageModel" Version="1.0.0-preview" />
    <PackageVersion Include="CommunityToolkit.VectorData.Qdrant" Version="1.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DataIngestion" Version="11.0.0-preview.1.26560.3" />
    <PackageVersion Include="Microsoft.Extensions.DocumentExtraction" Version="11.0.0-preview.1.26560.3" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="11.0.0" />
    <!-- Transitive via Microsoft.ML.Tokenizers.Data.O200kBase; 9.0.4 has GHSA-73j8-2gch-69rq. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="Qdrant.Client" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Label="Jellyfin">
    <PackageVersion Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageVersion Include="Jellyfin.Database.Implementations" Version="12.0.0" />
    <PackageVersion Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
