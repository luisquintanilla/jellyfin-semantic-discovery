<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>970cc338-9686-4668-b94c-9d052006e3b8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Qdrant" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the plugin with the AppHost so AppHost.cs can copy it into Jellyfin's plugin folder. -->
    <ProjectReference Include="..\Jellyfin.SemanticDiscovery.Plugin\Jellyfin.SemanticDiscovery.Plugin.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
